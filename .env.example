# Telegram bot token from @BotFather (never commit a real token)
CLANKER_UPDATES_TOKEN=your_telegram_bot_token_here

# Numeric private Telegram chat ID allowed to talk to the bridge (e.g. 123456789)
CLANKER_UPDATES_CHAT_ID=your_numeric_chat_id_here

# Optional path to your firstmate home directory (defaults to $HOME/firstmate)
# FIRSTMATE_HOME=/path/to/firstmate
