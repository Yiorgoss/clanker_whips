{
  "name": "@clanker-whips/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local metrics and tracing pipeline for Pi agents (Pi extension, outbound HTTP/HTTPS metadata proxy, OTel JSONL + SQLite store, CLI).",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pi-extension": "./src/pi-extension.ts",
    "./proxy": "./src/proxy.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "clanker-telemetry": "./src/cli.ts"
  },
  "pi": {
    "extensions": ["./src/pi-extension.ts"]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "cli": "node src/cli.ts",
    "proxy": "node src/cli.ts proxy"
  },
  "dependencies": {
    "effect": "4.0.4"
  }
}
